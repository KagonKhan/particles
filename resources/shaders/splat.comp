#version 440

layout(local_size_x = 256) in;

// std430 gives an array of vec2 an 8-byte stride, which is exactly how glm::vec2 is
// packed on the CPU, so this declaration matches the memcpy'd pool as-is. (A vec3 array
// would not: std430 pads it to a 16-byte stride and the two layouts disagree.)
layout(std430, binding = 0) readonly buffer Particles
{
    vec2 positions[]; // world space, flat in z
};

layout(r32ui, binding = 1) uniform uimage2D densityImage;

uniform uint particleCount;
uniform ivec2 screenSize;
uniform mat4 viewProj;

uniform float depthFalloff;   // 0 = flat, 1 = 1/depth, 2 = inverse-square
uniform float depthReference; // depth at which a particle contributes exactly 1.0
uniform vec4 viewRowZ;        // third row of the view matrix, see below

uniform int particleRadius;   // splat radius in pixels; 0 writes a single pixel

// The density image holds integers, so weighted contributions are accumulated as
// fixed point: one unit of density is kDensityScale counts. density.frag divides
// this back out, so the two files must agree on the value.
const uint  kDensityScale = 64u;
const float kMaxWeight    = 4.0; // caps how bright a near particle can get, and
                                 // bounds how fast the 32-bit texture can overflow

void main()
{
    // The dispatch is a 2D grid of 1D groups, because one dimension caps at 65535 groups
    // on D3D12-backed drivers — only ~16.7M particles, which this system passes easily.
    // Row Y covers gl_NumWorkGroups.x groups, hence the stride.
    uint idx = (gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
    if (idx >= particleCount) {
        return; // ragged tail of the last row
    }

    // The simulation is flat, so every particle sits at z = 0. The camera is not, which
    // is why the depth term further down still has something to say.
    vec4 world = vec4(positions[idx], 0.0, 1.0);

    vec4 clip = viewProj * world;
    if (clip.w <= 0.0) {
        return; // behind the eye, the perspective divide would mirror it back on screen
    }

    vec3 ndc = clip.xyz / clip.w;
    if (abs(ndc.z) > 1.0) {
        return; // outside the depth range
    }

    // Off-screen by less than the splat radius still puts part of the disc on screen, so
    // the frustum test is widened by exactly that much — otherwise discs pop into
    // existence at the frame edge instead of sliding in.
    vec2 slack = (vec2(float(particleRadius)) / vec2(screenSize)) * 2.0;
    if (any(greaterThan(abs(ndc.xy), vec2(1.0) + slack))) {
        return;
    }

    // NDC [-1,1] -> pixel coords [0, screenSize). Deliberately not clamped: a particle
    // inside the slack band above lies outside the image, and clamping would pile every
    // one of them onto the border pixel. The per-write bounds test below is the guard.
    // floor, not a plain cast: the slack band produces negative coordinates, and a cast
    // truncates those toward zero, sliding the disc a pixel inward at the left and top.
    ivec2 pixel = ivec2(floor((ndc.xy * 0.5 + 0.5) * vec2(screenSize)));

    // Distance along the camera's forward axis. Taking it from the view matrix rather
    // than from clip.w is what lets one shader serve both projections: clip.w is the
    // depth only under perspective, and is pinned at 1.0 under orthographic.
    // Only row 2 of the view matrix contributes, so it travels as a single vec4.
    // Using forward-axis depth rather than euclidean distance to the eye also keeps
    // brightness even across the screen instead of dimming toward the corners of a
    // wide field of view.
    float depth = -dot(viewRowZ, world);

    float weight = pow(depthReference / max(depth, 1e-3), depthFalloff);
    weight       = clamp(weight, 0.0, kMaxWeight);

    // Splat a disc rather than a single pixel. Cost is quadratic in the radius — every
    // pixel of it is an atomic — so this is the one setting that can sink the frame
    // rate on its own at high particle counts.
    int radius = particleRadius;

    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            float dist = sqrt(float((dx * dx) + (dy * dy)));
            if (dist > float(radius)) {
                continue; // round splat, not square
            }

            ivec2 target = pixel + ivec2(dx, dy);
            if (any(lessThan(target, ivec2(0))) || any(greaterThanEqual(target, screenSize))) {
                continue;
            }

            // Linear falloff to the rim. Dividing by radius+1 rather than radius keeps
            // the rim just above zero, and leaves radius 0 at full weight.
            float falloff = 1.0 - (dist / float(radius + 1));

            // Floor at one quantum so a distant cloud still accumulates into a haze
            // rather than rounding away to nothing particle by particle.
            uint contribution = max(uint(weight * falloff * float(kDensityScale)), 1u);
            imageAtomicAdd(densityImage, target, contribution);
        }
    }
}
